    "i": 296967,
    "d": "2025-11-13T17:49:44",
    "u": 1000003168,
    "t": "يارب أوصيك بقبر جدي خير وصيّه انِره من كل الجهات وأجمعنا به في جنة الفردوس"
  },
  {
    "s": "wa",
    "i": 10743,
    "d": "2025-11-13T17:50:00",
    "u": 2000000894,
    "t": "لا تجيهم نصيحه\nاغلب حقين محلات فحص النظر ينقصون عشان تشتري من عندهم\nبذات eyewa جيته ومنقصني ١.٥ وانا ناقص ربع بس"
  },
  {
    "s": "wa",
    "i": 10744,
    "d": "2025-11-13T17:54:00",
    "u": 2000000441,
    "t": "وعليكم السلام ، مستوصف المغربي كويس"
  },
  {
    "s": "wa",
    "i": 10745,
    "d": "2025-11-13T18:05:00",
    "u": 2000000605,
    "t": "السلام عليكم. شريت من البقالة وطلع الي شريته خربان ومنتهي من قبل كم يوم"
  },
  {
    "s": "wa",
    "i": 10746,
    "d": "2025-11-13T18:06:00",
    "u": 2000000605,
    "t": "مب المفروض اذا جا يحاسب يطلع له انه منتهي؟"
  },
  {
    "s": "wa",
    "i": 10747,
    "d": "2025-11-13T18:06:00",
    "u": 2000000605,
    "t": "ابغى اروح لهم بس ابغى اعرف البقالة الحين فاتحه ولا؟"
  },
  {
    "s": "wa",
    "i": 10748,
    "d": "2025-11-13T18:09:00",
    "u": 2000000367,
    "t": "ايه فاتحه"
  },
  {
    "s": "wa",
    "i": 10749,
    "d": "2025-11-13T18:13:00",
    "u": 2000000282,
    "t": "كيف يطلع له"
  },
  {
    "s": "wa",
    "i": 10750,
    "d": "2025-11-13T18:14:00",
    "u": 2000000605,
    "t": "الجهاز الي يحاسب فيه وينسخ باركود المنتج"
