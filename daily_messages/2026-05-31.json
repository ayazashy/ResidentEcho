  },
  {
    "s": "wa",
    "i": 36936,
    "d": "2026-05-31T14:33:00",
    "u": 2000000545,
    "t": "لا مفتوحه"
  },
  {
    "s": "wa",
    "i": 36937,
    "d": "2026-05-31T14:36:00",
    "u": 2000000339,
    "t": "البقاله مفتوحه \nوعلى نظامها السابق من 6 ص الى 2 ص \n\nفي الايام السابقه كانت تسكر الساعه 12 \nإجازة عيد \nوالطلاب كمان كانو في إجازه"
  },
  {
    "s": "tg",
    "i": 415593,
    "d": "2026-05-31T14:42:23",
    "u": 1000000022,
    "t": "\"قُل: لا حَولَ ولا قوَّةَ إلَّا باللهِ\n\nفإنَّها كَنزٌ مِن كُنوزِ الجَنَّةِ\" صحيح البخاري"
  },
