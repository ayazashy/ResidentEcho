    "d": "2026-05-31T19:50:57",
    "u": 1000002953,
    "t": "يا اخوان متى اخر وقت للأشتراك في المطعم"
  },
  {
    "s": "wa",
    "i": 36946,
    "d": "2026-05-31T20:02:00",
    "u": 2000000737,
    "t": "الاشتراك فتح لذا الشهر؟"
  },
  {
    "s": "tg",
    "i": 415612,
    "d": "2026-05-31T20:06:27",
    "u": 1000000378,
    "t": "ياخوان انا عندي غرفة وماعندي وابي اجدد العقد مع الموقف واذا حطيت تجديد مع موقف يقول مافي مناطق شالوضع"
  },
  {
    "s": "wa",
    "i": 36947,
    "d": "2026-05-31T20:27:00",
    "u": 2000000909,
    "t": "اي مفتوح للي بيشترك شهر كامل \nاما اللي بيشترك ١٥ يوم فلحد الان"
  },
  {
    "s": "wa",
    "i": 36948,
    "d": "2026-05-31T20:28:00",
    "u": 2000000839,
    "t": "لو بسافر متاخر شوي محد بيقولي شي صح؟"
  },
