    "t": "تدفع 50 تجديد ستكر"
  },
  {
    "s": "wa",
    "i": 36939,
    "d": "2026-05-31T14:49:00",
    "u": 2000000426,
    "t": "اذا الستكر موب معك"
  },
  {
    "s": "tg",
    "i": 415594,
    "d": "2026-05-31T15:07:20",
    "u": 1000002660,
    "t": "يخوان الصيانة ما تداوم اليوم ولا كيف؟"
  },
  {
    "s": "wa",
    "i": 36940,
    "d": "2026-05-31T15:11:00",
    "u": 2000000592,
    "t": "البهو مقفلة\nالسكن اكيد فاتحة؟"
